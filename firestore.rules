rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Authentication & Role Verification Functions
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.phone_number == '+919904579700' ||
        request.auth.token.phone_number == '9904579700' ||
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'superAdmin') ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. Products Collection
    // - Read: All buyers & visitors can browse the catalog
    // - Write: Strictly restricted to Super Admin
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Orders Collection
    // - Read: Buyer owning the order OR Super Admin
    // - Create: Authenticated buyer placing their own pending order
    // - Update: Super Admin can update any field (status, delivery, payment).
    //           Buyer can only update non-financial fields on their pending order.
    //           Buyers CANNOT change totalAmount, paymentStatus, or items.
    // - Delete: Super Admin only (buyers cancel orders via status, not hard delete)
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        isSuperAdmin()
      ) && (
        isSuperAdmin() ||
        request.resource.data.orderStatus == 'pending'
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource.data.customerId == request.auth.uid &&
          request.resource.data.customerId == request.auth.uid &&
          resource.data.orderStatus == 'pending' &&
          // Tamper-proofing: buyers cannot manipulate pricing, payment, or line items directly
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'totalAmount',
            'paymentStatus',
            'paymentMethod',
            'items',
            'orderNumber',
            'pickupCode'
          ])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 3. Users / Resellers Collection
    // - Read: User themselves OR Super Admin
    // - Create: User themselves upon registration (forbidden from self-assigning superAdmin)
    // - Update: User themselves (forbidden from elevating role or totalPurchases) OR Super Admin
    // - Delete: Super Admin only
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role == 'customer' ||
        isSuperAdmin()
      );

      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalPurchases'])
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. Bulk Quote Inquiries & Two-Way Negotiation Chat
    // - Inquiries Read: Inquiry creator OR Super Admin
    // - Inquiries Create: Authenticated buyer creating their own inquiry
    // - Inquiries Update: Super Admin OR creator updating contact/notes
    // - Messages: Participants (inquiry creator or admin) can read and post
    // =========================================================================
    match /bulk_inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
      );

      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/bulk_inquiries/$(inquiryId)).data.userId == request.auth.uid ||
          isSuperAdmin()
        );

        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/bulk_inquiries/$(inquiryId)).data.userId == request.auth.uid ||
          isSuperAdmin()
        );

        allow update, delete: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 5. System Configuration & Security Store
    // =========================================================================
    match /system_config/{configId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 6. Default Deny Fallback
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
